# Backend Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Local Storage Settings (100% Close-Environment - No Cloud DB needed)
# ChromaDB vectors and SQLite database will be saved inside this folder
LOCAL_DATA_DIR=./local_data
CHROMA_COLLECTION_NAME=legal_documents_chunks

# Local LLM Configuration (Using Ollama so legal documents stay private on local machine)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
SUBAGENT_MODEL=qwen2.5:7b

# Local Embeddings Configuration (768-dimension vectors via Ollama)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768

# Observability (Optional - from tutorial)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-rag-learning
